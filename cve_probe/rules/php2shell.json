  "cves": {
    "CVE-2026-109618": {
      "summary": "out-of-memory handling leaves uninitialized request state; mitigated only by memory_limit=-1 plus external request size limits",
      "mitigations": [
        {"ini": "memory_limit", "equals": "-1"}
      ]
    },
    "CVE-2026-109619": {
      "summary": "worker reuses stale state via session.upload_progress (and fatal_error_backtraces on 8.5)",
      "mitigations": [
        {"ini": "session.upload_progress.enabled", "in": ["off", "0", ""]},
        {"ini": "fatal_error_backtraces", "in": ["off", "0", ""], "branch_min": "8.5"}
      ]
    }
  }
