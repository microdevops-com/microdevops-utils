{
  "family": "tcp-ireq-opt-uaf",
  "title": "IPv4 TCP request socket IP options use-after-free, remote kernel memory corruption",
  "kind": "kernel",
  "references": [
    "https://ubuntu.com/security/CVE-2026-98432",
    "https://security-tracker.debian.org/tracker/CVE-2026-98432",
    "https://access.redhat.com/hydra/rest/securitydata/cve/CVE-2026-98432.json",
    "https://access.redhat.com/security/vulnerabilities/RHSB-2026-016"
  ],
  "affected_from": "4.4",
  "affected_before": "7.3.0",
  "firewall_mitigations": [
    {"tool": "nft",
     "match": "ip hdrlength (> 5|gt 5|!= 5|ne 5|6-15)\\b.*\\b(drop|reject)\\b",
     "unless": "\\b((tcp|th) [sd]port|iifname|iif|oifname|oif|ip [sd]addr|meta mark|ct mark)\\b"},
    {"tool": "iptables",
     "match": "(-m u32 --u32 \"?(0x0|0)>>(0x18|24)&0x0?[fF]=(0x6|6):(0xf|0xF|15)\"?|-m ipv4options --any-opt).*-j (DROP|REJECT)",
     "unless": "--[sd]ports?\\b|\\s-[isd]\\s|--(in-interface|source|destination|src-range|dst-range|mark)\\b|-m set\\b"}
  ],
  "remedy": "upgrade to the fixed kernel where one exists; while none is running, drop inbound TCP carrying IP options before conntrack and DNAT so host and container ports are both covered: iptables -t raw -I PREROUTING 1 -p tcp -m u32 --u32 '0>>24&0x0f=6:15' -j DROP  (nft: chain type filter hook prerouting priority -310, rule: ip protocol tcp ip hdrlength > 5 counter drop)",
  "cves": {
    "CVE-2026-98432": {
      "public": "2026-10-15",
      "summary": "ireq_opt of an IPv4 TCP request socket is freed without RCU grace period and reused by a retransmitted SYN that carries IP options; remote, unauthenticated, any listening TCP port; secondary path via tcp_migrate_req; fixed upstream by freeing with kfree_rcu (7.3-rc7, stable 5.10.272 5.15.223 6.1.190 6.6.159 6.12.113 6.18.56 7.2.10)",
      "not_affected_distros": {"ubuntu": ["14.04"]},
